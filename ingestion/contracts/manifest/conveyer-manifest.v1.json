{
  "$defs": {
    "ManifestFile": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "record_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Count"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "name",
        "bytes",
        "sha256"
      ],
      "title": "ManifestFile",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    },
    "feed_id": {
      "title": "Feed Id",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/ManifestFile"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Files",
      "type": "array"
    },
    "manifest_id": {
      "title": "Manifest Id",
      "type": "string"
    },
    "manifest_version": {
      "const": 1,
      "title": "Manifest Version",
      "type": "integer"
    }
  },
  "required": [
    "manifest_version",
    "manifest_id",
    "feed_id",
    "files"
  ],
  "title": "ManifestV1",
  "type": "object"
}
